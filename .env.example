# Provider: "ollama" or "openai"
LLM_PROVIDER=ollama

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2

# OpenAI settings (if LLM_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-api-key-here
# LLM_MODEL=gpt-4o-mini

# Tavily web search
TAVILY_API_KEY=your-tavily-api-key-here
